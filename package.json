{
	"type": "module",
	"name": "zensloom",
	"packageManager": "pnpm@10.5.2",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "pnpm run --filter=@zensloom/desktop dev",
		"dev:desktop": "pnpm run --filter=@zensloom/desktop dev",
		"format": "pnpm exec biome check --write .",
		"lint": "pnpm exec biome check .",
		"tauri:build": "node scripts/build-zensloom-muxer.mjs && pnpm --dir apps/desktop run preparescript && pnpm --dir apps/desktop tauri build --verbose",
		"typecheck": "pnpm tsc -b",
		"test": "turbo run test",
		"test:discover": "cargo run -p cap-test -- discover",
		"test:matrix": "cargo run -p cap-test -- matrix",
		"test:matrix:quick": "cargo run -p cap-test -- matrix --quick",
		"test:suite:recording": "cargo run -p cap-test -- suite recording",
		"test:suite:encoding": "cargo run -p cap-test -- suite encoding",
		"test:suite:playback": "cargo run -p cap-test -- suite playback",
		"test:suite:sync": "cargo run -p cap-test -- suite sync",
		"clean": "find . -name node_modules -o -name .next -o -name .output -o -name .turbo -o -name dist -type d -prune | xargs rm -rf",
		"check-tauri-versions": "node scripts/check-tauri-plugin-versions.js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"turbo": "^2.3.4",
		"typescript": "^5.8.3"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {}
		}
	}
}
